APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Demo seed credentials. Leave empty to generate random passwords (printed once at seed time).
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Login rate limiting (POST /auth/login). Failed attempts per decay window, per email/IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1

# URL of the standalone demand forecasting service (FastAPI).
# This has been removed - forecasting is now handled internally via Laravel.

# CORS is configured entirely from these env vars (no hardcoded origins).
# CORS_ALLOWED_ORIGINS: comma-separated exact origins allowed to call the API.
# CORS_ALLOWED_ORIGINS_PATTERNS: comma-separated PCRE patterns (with delimiters)
#   for dynamic origins (e.g. Vercel preview domains).
# CORS_SUPPORTS_CREDENTIALS: allow cookies / Authorization with cross-origin requests.
# CORS_MAX_AGE: preflight cache seconds.
# Never use '*' for origins when credentials are enabled.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
APP_RESTAURANT_TIMEZONE=Asia/Manila
TIMECHO_API_KEY=
TIMECHO_BASE_URL=https://ai.timecho.com
TIMECHO_FORECAST_PATH=/ai/api/v1/forecast
TIMECHO_MODEL=
