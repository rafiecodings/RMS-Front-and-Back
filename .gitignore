# RMS Monorepo — combined ignores (frontend + backend)
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
/test-results/
/playwright-report/

# next.js
**/.next/
/out/

# production
build/

# misc
.DS_Store
*.pem
Thumbs.db
nul
*.tmp
*.sqlite
check_*_status.php
restaurant-frontend/scripts/dev-dbg.mjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- backend (Laravel) ----
**/vendor/
storage/logs/*.log
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/publicbuild/
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
