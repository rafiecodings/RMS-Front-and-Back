APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT OVERRIDES
# Copy these values into the server-side .env (never into the repository, and
# never into the frontend). APP_KEY is generated once per environment with:
#   php artisan key:generate --show
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false                 # never expose stack traces / env in responses
# APP_URL=https://api.your-domain.com
# LOG_LEVEL=info
# SESSION_SECURE_COOKIE=true      # defaults to true when APP_ENV=production
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
# SESSION_DRIVER=database
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com   # exact origin(s); never '*' with credentials
# SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.com        # only if cookie/SPA auth is used cross-origin
# DEV_PER_TAB_AUTH=false          # dev-only bypass; ignored unless APP_ENV=local
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_DECAY_MINUTES=1
#
# Production database credentials MUST come from the environment:
# DB_CONNECTION=pgsql
# DB_HOST=...
# DB_PORT=5432
# DB_DATABASE=...
# DB_USERNAME=...
# DB_PASSWORD=...
#
# AI provider keys stay server-side only (config/services.php). They are read
# by the API only — never expose them through a NEXT_PUBLIC_* variable.

# Demo seed credentials. Leave empty to generate random passwords (printed once at seed time).
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Dev-only per-tab auth: allows multiple roles logged in simultaneously in different tabs.
# Requires BOTH APP_ENV=local AND DEV_PER_TAB_AUTH=true.
# NEVER enable in production.
DEV_PER_TAB_AUTH=false

# Login rate limiting (POST /auth/login). Failed attempts per decay window, per email/IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1

# CORS is configured entirely from these env vars (no hardcoded origins).
# CORS_ALLOWED_ORIGINS: comma-separated exact origins allowed to call the API.
# CORS_ALLOWED_ORIGINS_PATTERNS: comma-separated PCRE patterns (with delimiters)
#   for dynamic origins (e.g. Vercel preview domains).
# CORS_SUPPORTS_CREDENTIALS: allow cookies / Authorization with cross-origin requests.
# CORS_MAX_AGE: preflight cache seconds.
# Never use '*' for origins when credentials are enabled.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Gemini AI insights (server-side only). Leave empty to fall back to local statistical forecast.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Timecho demand forecasting (server-side only). Leave empty to fall back to local forecast.
TIMECHO_API_KEY=
TIMECHO_BASE_URL=https://ai.timecho.com

# Mail — production SMTP. Local development may keep MAIL_MAILER=log (or
# array in tests) and use its own credentials without touching these.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps              # canonical Laravel switch; wins over MAIL_ENCRYPTION
# MAIL_ENCRYPTION=tls            # accepted alias: tls/starttls -> smtp, ssl/smtps -> smtps
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@your-domain.com   # must be a verified sender
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_TIMEOUT=30

# Frontend (Next.js) base URL. REQUIRED in production: password-reset links and
# two-factor emails point here. Never a backend URL, never hardcoded localhost.
# FRONTEND_URL=https://your-frontend-domain.com

# Password reset token lifetime (minutes) and per-address resend throttle (seconds)
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
FORGOT_PASSWORD_MAX_PER_MINUTES=3

# Two-factor authentication (TOTP)
# TWO_FACTOR_ISSUER="${APP_NAME}"
# TWO_FACTOR_WINDOW=1                                  # periods of clock drift tolerated
# TWO_FACTOR_CHALLENGE_LIFETIME=5                      # minutes to finish a 2FA login
# TWO_FACTOR_MAX_ATTEMPTS=5                            # code attempts per challenge
# TWO_FACTOR_RECOVERY_CODES=8
# TWO_FACTOR_ENROLLMENT_LIFETIME=10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
